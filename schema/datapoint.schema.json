{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OwnYourData/dpp-criteria/schema/datapoint.schema.json",
  "title": "DPP data point",
  "description": "A data point that a legal act requires, allows or expects in a digital product passport. Data points are reference material for criteria; they are not checked themselves.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "regime",
    "tier",
    "name",
    "description",
    "access",
    "basis"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^DP-(ESPR|TOY|CPR|EUDR|BATT)-[0-9]{3}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "regime": {
      "description": "Legal act that defines the data point.",
      "enum": [
        "ESPR",
        "TOY",
        "CPR",
        "EUDR",
        "BATT"
      ]
    },
    "tier": {
      "description": "How firmly the legal act fixes the data point. ESPR: fixed, minimum, conditional, delegated-act, annex-i, voluntary. Product-specific acts (TOY, CPR, BATT): regime. Law outside DPP rules: sectoral.",
      "enum": [
        "fixed",
        "minimum",
        "conditional",
        "delegated-act",
        "annex-i",
        "voluntary",
        "regime",
        "sectoral"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "term": {
      "description": "Term used in the English version of the legal act.",
      "type": "string"
    },
    "en18223_attribute": {
      "description": "Attribute of the class DigitalProductPassport (EN 18223:2026, Table 1) that carries the value, if any.",
      "enum": [
        "digitalProductPassportId",
        "uniqueProductIdentifier",
        "granularity",
        "dppSchemaVersion",
        "dppStatus",
        "lastUpdated",
        "economicOperatorId",
        "facilityId",
        "contentSpecificationIds"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "granularity": {
      "description": "Level the value refers to (model, batch, item, product type, substance, ...).",
      "type": "string"
    },
    "provided_by": {
      "description": "Actor that produces the value.",
      "type": "string"
    },
    "access": {
      "description": "public: the legal act puts the value in the public part, or requires it on the product or via the data carrier without access restriction. restricted: the legal act limits it to named actors. delegated-act: left to the delegated or implementing act. unspecified: the legal act says nothing about access.",
      "enum": [
        "public",
        "restricted",
        "delegated-act",
        "unspecified"
      ]
    },
    "access_notes": {
      "type": "string"
    },
    "battery_applicability": {
      "description": "Only for regime BATT: whether the data point is to be provided for each battery category with a battery passport (Regulation (EU) 2023/1542, Art. 77(1)).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ev",
        "lmt",
        "industrial"
      ],
      "properties": {
        "ev": {
          "$ref": "#/$defs/batteryCategoryApplicability",
          "description": "Electric vehicle batteries."
        },
        "lmt": {
          "$ref": "#/$defs/batteryCategoryApplicability",
          "description": "LMT batteries (light means of transport)."
        },
        "industrial": {
          "$ref": "#/$defs/batteryCategoryApplicability",
          "description": "Industrial batteries with a capacity greater than 2 kWh."
        }
      }
    },
    "basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "kind"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "clause": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "regulation",
              "harmonised-standard",
              "draft-standard",
              "standard",
              "guidance",
              "derived"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "batteryCategoryApplicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "description": "mandatory: to be provided. optional: to be provided if the information is available. if-applicable: to be provided where the condition in note applies. not-to-be-filled: not to be provided or displayed, see reason.",
          "enum": [
            "mandatory",
            "optional",
            "if-applicable",
            "not-to-be-filled"
          ]
        },
        "reason": {
          "description": "Why the data point is not to be provided. repetition: the same information is already provided under the data points in same_as. pending-implementing-act / pending-delegated-act: the act that specifies the information has not been adopted. applies-later: the information is required from applies_from. on-hold: the guidance has set the data point aside. not-for-category: the data point does not apply to this battery category.",
          "enum": [
            "repetition",
            "pending-implementing-act",
            "pending-delegated-act",
            "applies-later",
            "on-hold",
            "not-for-category"
          ]
        },
        "same_as": {
          "description": "With reason repetition: the data points that already carry the information.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^DP-BATT-[0-9]{3}$"
          }
        },
        "applies_from": {
          "description": "Date from which the data point is required, where the legal act or the guidance names one: YYYY-MM-DD, or YYYY-MM if only the month is named.",
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?$"
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "not-to-be-filled"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ]
          },
          "else": {
            "not": {
              "required": [
                "reason"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "same_as"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "const": "repetition"
              }
            },
            "required": [
              "reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "reason": {
                "const": "repetition"
              }
            },
            "required": [
              "reason"
            ]
          },
          "then": {
            "required": [
              "same_as"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "reason": {
                "const": "applies-later"
              }
            },
            "required": [
              "reason"
            ]
          },
          "then": {
            "required": [
              "applies_from"
            ]
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "regime": {
            "const": "BATT"
          }
        },
        "required": [
          "regime"
        ]
      },
      "then": {
        "required": [
          "battery_applicability"
        ],
        "properties": {
          "id": {
            "pattern": "^DP-BATT-"
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "battery_applicability"
          ]
        }
      }
    }
  ]
}
