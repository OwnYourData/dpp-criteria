{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OwnYourData/dpp-criteria/schema/service.schema.json",
  "title": "Listed DPP service",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "operator", "entry", "licence", "check", "listed_since"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "type": "string" },
    "url": { "type": "string", "pattern": "^https://", "description": "Web page of the service or of the software." },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "description": "The organisation that runs the service or, for software without a public instance, publishes it.",
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "country": { "type": "string", "pattern": "^[A-Z]{2}$", "description": "ISO 3166-1 alpha-2 code of the operator's seat." }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "as_of"],
      "description": "Who maintains the entry: the operator (pull request by the operator or with linked consent) or the maintainers from their own research.",
      "properties": {
        "source": { "enum": ["operator", "research"] },
        "as_of": { "type": "string", "format": "date", "description": "Date on which the information in the entry was last checked." }
      }
    },
    "licence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "spdx"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "description": "Licence as shown to people, e.g. for a service that is commercial with open parts." },
        "spdx": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]*$" }, "description": "SPDX identifiers of the licences of the software; empty if none applies." }
      }
    },
    "source_code": { "type": "string", "pattern": "^https://", "description": "Public repository of the software, if any." },
    "example_passports": {
      "type": "array",
      "maxItems": 3,
      "description": "Product identifiers of passports the service publishes; checked with dpplint.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["product_id", "label"],
        "properties": {
          "product_id": { "type": "string", "pattern": "^https://" },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "description": "How dpp-validator checks the service: full-daily (operator entries), read-only-weekly (research entries) or none, with the reason.",
      "properties": {
        "mode": { "enum": ["full-daily", "read-only-weekly", "none"] },
        "reason": { "enum": ["needs_credentials", "no_public_instance", "no_en18222_paths"] }
      },
      "if": { "properties": { "mode": { "const": "none" } } },
      "then": { "required": ["reason"] },
      "else": { "not": { "required": ["reason"] } }
    },
    "contact": { "type": "string" },
    "api_base": { "type": "string", "pattern": "^https://" },
    "features": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["fine-granular-api", "write-api", "historical-versions", "access-levels", "backup-provider", "registry-integration", "battery", "pcds"] }
    },
    "not_implemented": {
      "type": "array",
      "uniqueItems": true,
      "description": "Feature flags the service does not offer yet although they concern it; criteria requiring them are skipped with reason_code not_implemented. A flag may not also be in features.",
      "items": { "enum": ["fine-granular-api", "write-api", "historical-versions", "access-levels", "backup-provider", "registry-integration", "battery", "pcds"] }
    },
    "test_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productId", "dppId"],
      "properties": {
        "productId": { "type": "string" },
        "dppId": { "type": "string" },
        "elementIdPath": { "type": "string", "pattern": "^\\$", "description": "RFC 9535 JSONPath of a data element in the test passport; needed for fine-granular-api checks." },
        "controlledElementId": { "type": "string", "minLength": 1, "description": "elementId of a controlled data element in the test passport; needed for access-levels checks." },
        "controlledElementIdPath": { "type": "string", "pattern": "^\\$", "description": "RFC 9535 JSONPath of that controlled data element in the compressed representation; needed for access-levels checks with fine-granular-api." }
      }
    },
    "credentials": { "type": "string", "pattern": "^(none|secret:[A-Z][A-Z0-9_]*)$" },
    "declarations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "statement", "evidence"],
        "properties": {
          "criterion": { "type": "string", "pattern": "^DPP-[A-Z]{2,5}-[0-9]{3}$" },
          "statement": { "type": "string" },
          "evidence": { "type": "string", "pattern": "^https://" }
        }
      }
    },
    "consent": { "type": "string", "description": "Link to the operator's consent if the PR is not opened by the operator." },
    "notes": { "type": "string", "description": "Remarks shown with the entry, e.g. why a service is not checked." },
    "listed_since": { "type": "string", "format": "date" }
  },
  "$comment": "Operator entries are checked in full every day and need everything a full run uses. Research entries are checked read-only at most weekly, or not at all; they carry no credentials, declarations or consent. A service that is checked needs an api_base. A feature flag may not be in both features and not_implemented.",
  "allOf": [
    {
      "if": { "required": ["entry"], "properties": { "entry": { "required": ["source"], "properties": { "source": { "const": "operator" } } } } },
      "then": {
        "required": ["contact", "api_base", "features", "test_data", "credentials"],
        "properties": { "check": { "properties": { "mode": { "const": "full-daily" } } } }
      }
    },
    {
      "if": { "required": ["entry"], "properties": { "entry": { "required": ["source"], "properties": { "source": { "const": "research" } } } } },
      "then": {
        "properties": {
          "check": { "properties": { "mode": { "enum": ["read-only-weekly", "none"] } } },
          "credentials": { "const": "none" }
        },
        "not": { "anyOf": [{ "required": ["declarations"] }, { "required": ["consent"] }] }
      }
    },
    {
      "if": { "required": ["check"], "properties": { "check": { "required": ["mode"], "properties": { "mode": { "enum": ["full-daily", "read-only-weekly"] } } } } },
      "then": { "required": ["api_base"] }
    },
    { "if": { "required": ["features"], "properties": { "features": { "contains": { "const": "fine-granular-api" } } } }, "then": { "properties": { "not_implemented": { "not": { "contains": { "const": "fine-granular-api" } } } } } },
    { "if": { "required": ["features"], "properties": { "features": { "contains": { "const": "write-api" } } } }, "then": { "properties": { "not_implemented": { "not": { "contains": { "const": "write-api" } } } } } },
    { "if": { "required": ["features"], "properties": { "features": { "contains": { "const": "historical-versions" } } } }, "then": { "properties": { "not_implemented": { "not": { "contains": { "const": "historical-versions" } } } } } },
    { "if": { "required": ["features"], "properties": { "features": { "contains": { "const": "access-levels" } } } }, "then": { "properties": { "not_implemented": { "not": { "contains": { "const": "access-levels" } } } } } },
    { "if": { "required": ["features"], "properties": { "features": { "contains": { "const": "backup-provider" } } } }, "then": { "properties": { "not_implemented": { "not": { "contains": { "const": "backup-provider" } } } } } },
    { "if": { "required": ["features"], "properties": { "features": { "contains": { "const": "registry-integration" } } } }, "then": { "properties": { "not_implemented": { "not": { "contains": { "const": "registry-integration" } } } } } },
    { "if": { "required": ["features"], "properties": { "features": { "contains": { "const": "battery" } } } }, "then": { "properties": { "not_implemented": { "not": { "contains": { "const": "battery" } } } } } },
    { "if": { "required": ["features"], "properties": { "features": { "contains": { "const": "pcds" } } } }, "then": { "properties": { "not_implemented": { "not": { "contains": { "const": "pcds" } } } } } }
  ]
}
